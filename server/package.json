{
  "name": "fiszki-server",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply fiszki --local",
    "db:migrate:remote": "wrangler d1 migrations apply fiszki --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
